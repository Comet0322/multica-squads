# multica-test-t1-design optional local credentials template (not needed by default)
# Recommended: configure accounts as OS environment variables; the Skill reads system variables first
# Only when system variables are missing, copy this file to config.local.env as a fallback
# WARNING: contains passwords/tokens; do not commit to the repo (already in .gitignore)

# ---- Jira / Confluence (configure at least one set)----
# Recommended: domain account
# JIRA_USERNAME=
# JIRA_PASSWORD=

# Or: self-hosted username/password
# JIRA_USERNAME=
# JIRA_PASSWORD=

# Or: Cloud
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# Fallback cookies (expire easily, not recommended)
# JIRA_COOKIE=
# CONFLUENCE_COOKIE=

# ---- Figma (as needed)----
# FIGMA_TOKEN=

# ---- Team knowledge-base bridge (as needed; may be omitted when defaults apply)----
# TEAM_KB_URL=https://team-kb.example.com
# TEAM_KB_TIMEOUT=600
